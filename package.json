{
  "name": "studio-karaoke",
  "productName": "Studio Karaoke",
  "version": "0.1.0",
  "description": "Studio Karaoke – canta su YouTube e registra il tuo disco",
  "author": "Studio Karaoke",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:finestra": "cross-env STUDIO_WINDOWED=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "finto-youtube": "node dev/finto-youtube/server.mjs",
    "dev:finto-youtube": "cross-env STUDIO_WINDOWED=1 STUDIO_YT_URL=http://127.0.0.1:8765 electron-vite dev"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "electron-store": "^11.0.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.78.0",
    "music-metadata": "^12.8.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "it.studiokaraoke.app",
    "productName": "Studio Karaoke",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Studio Karaoke",
      "runAfterFinish": true,
      "language": "1040"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ]
  }
}
